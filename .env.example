# Enterprise Environment Blueprint Configuration
# Rename this file to .env.local for local development. Never commit sensitive keys to source control.

# Application Environment Indicator ('development' | 'staging' | 'production')
NEXT_PUBLIC_APP_ENV=production

# Base Gateway API Endpoint for AST Parsing & Telemetry Services
NEXT_PUBLIC_API_BASE_URL=https://visualizer.internal

# OpenAI API Integration Key for Plain-English Architecture Explanations
OPENAI_API_KEY=your_secured_openai_token_here

# Local LLM Fallback Service Endpoint (e.g., Ollama or vLLM daemon)
LOCAL_LLM_ENDPOINT=http://localhost:11434
